{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAM",
  "version": "0.7.1",
  "identifier": "app.ram.accountmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "RAM",
        "width": 1180,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "backgroundColor": "#1e1e2e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tr.rbxcdn.com https://*.rbxcdn.com; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1M0UzODI1NDM4RjBGREMKUldUY0Q0OURKVGcrbFdnR0U4cEtyTm8vRWdUQ1dHTFJnNXA0ZVV6dlUrSFNaNXpGWmZ0bzhFVFoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
